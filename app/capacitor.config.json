{
  "appId": "br.com.lube.supervisor",
  "appName": "Supervisor Lube",
  "webDir": "www",
  "android": {
    "backgroundColor": "#050b1c",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#050b1c",
    "contentInset": "never"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "channelUrl": "",
      "statsUrl": "",
      "appReadyTimeout": 10000,
      "responseTimeout": 30,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
